      "900": { "value": "#0a251d" }
    },
    "neutral": {
      "$description": "Greige — warm-grey with a faint green cast, so surfaces sit under the pine rather than fighting it. 400 does double duty as border.strong (light) and foreground.muted (dark), which is what pins its value.",
