      "500": { "value": "#5f8138" },
      "700": { "value": "#3f5724" }
    },
    "warning": {
      "$description": "Ochre.",
      "100": { "value": "#f8ecd0" },
      "500": { "value": "#a97a18" },
      "700": { "value": "#7a5608" }
    },
    "danger": {
      "$description": "Brick.",
      "100": { "value": "#f7e0da" },
      "500": { "value": "#b8412f" },
      "700": { "value": "#8a2e20" }
