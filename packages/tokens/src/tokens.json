        "$description": "Dark mode uses the light end of the pine ramp for actions, so the label inverts to stay readable on it.",
        "value": "{color.neutral.0}",
        "dark": "{color.neutral.1000}"
      },
      "onDanger": {
        "$description": "Danger keeps the same brick in both themes, so its label stays light in both.",
        "value": "{color.neutral.0}",
        "dark": "{color.neutral.0}"
      },
      "inverse": { "value": "{color.neutral.0}", "dark": "{color.neutral.900}" }
    },
